    <Reference Include="System.Management"/><Reference Include="System.Windows.Forms"/>
    <Reference Include="System.Web.Extensions"/><Reference Include="System.Xml"/><Reference Include="Microsoft.CSharp"/>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)/Microsoft.CSharp.targets"/>
</Project>
