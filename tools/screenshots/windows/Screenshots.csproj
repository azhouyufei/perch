    <OutputType>Exe</OutputType><TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <LangVersion>7.3</LangVersion><AssemblyName>Perch.Screenshots</AssemblyName>
    <StartupObject>DeskToys.ScreenshotProgram</StartupObject><OutputPath>bin/</OutputPath>
